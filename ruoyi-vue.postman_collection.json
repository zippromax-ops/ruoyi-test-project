    {
      "name": "Login",
      "item": [
        {
          "name": "uuid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.environment.set(\"uuid\", jsonData.uuid);\r",
                  "    // 打印 data:image 链接，方便复制到浏览器查看验证码图片\r",
                  "    console.log(\"data:image/png;base64,\" + jsonData.img);\r",
                  "    if (jsonData.captchaEnabled === true) {\r",
                  "        pm.environment.set(\"uuid\", jsonData.uuid);\r",
                  "        console.log(\"✅ 获取验证码成功，uuid:\", jsonData.uuid);\r",
                  "        // 验证码图片是 base64 格式，可以手动解码查看或直接使用\r",
                  "    } else {\r",
                  "        console.log(\"验证码未开启\");\r",
                  "    }\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/captchaImage",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "captchaImage"
              ]
            }
          },
          "response": []
        },
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 提取 token\r",
                  "if (pm.response.code === 200) {\r",
