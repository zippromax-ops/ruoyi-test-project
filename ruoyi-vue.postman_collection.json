                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\r\n\"password\":\"admin123\",\r\n\"code\":\"\",\r\n\"uuid\":\"{{uuid}}\"}",
